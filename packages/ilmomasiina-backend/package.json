{
  "name": "@tietokilta/ilmomasiina-backend",
  "version": "3.0.0-alpha.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tietokilta/ilmomasiina.git"
  },
  "scripts": {
    "start": "bnr start:dev",
    "start:dev": "bnr start:dev",
    "start:prod": "pnpm build && bnr start:prod",
    "start:bench": "pnpm build && bnr start:bench",
    "loadTest": "k6 run loadTest.js",
    "stop:prod": "pm2 stop 0",
    "monit:prod": "pm2 monit",
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist coverage",
    "typecheck": "tsc --build tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "filldb": "tsx test/fillDatabase.ts"
  },
  "betterScripts": {
    "start:dev": {
      "command": "tsx watch src/bin/server.ts",
      "env": {
        "NODE_ENV": "development",
        "DEBUG": "app:*",
        "PORT": "3001"
      }
    },
    "start:prod": {
      "command": "pm2 start dist/bin/server.js",
      "env": {
        "NODE_ENV": "production",
        "DEBUG": "app:*"
      }
    },
    "start:bench": {
      "command": "node dist/bin/server.js",
      "env": {
        "NODE_ENV": "bench",
        "DEBUG": "app:*"
      }
    }
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/static": "^10.1.4",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@tietokilta/ilmomasiina-models": "workspace:*",
    "@types/pg": "^8.23.1",
    "@types/validator": "^13.15.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "base32-encode": "^2.0.0",
    "bcrypt": "^6.0.0",
    "better-npm-run": "^0.1.1",
    "debug": "^4.4.3",
    "dotenv-flow": "^4.1.0",
    "fast-jwt": "^6.3.3",
    "fastify": "^5.12.5",
    "http-errors": "^2.0.1",
    "i18next": "^26.4.2",
    "ics": "^3.12.0",
    "lodash": "^4.18.1",
    "mailgun.js": "^14.0.1",
    "moment": "^2.31.0",
    "moment-timezone": "^0.6.4",
    "mysql2": "^3.24.4",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "sequelize": "^6.37.8",
    "stripe": "^20.4.1",
    "typebox": "^1.3.34",
    "umzug": "^3.8.3",
    "validator": "^13.15.35",
    "web-resource-inliner": "^8.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/bcrypt": "^6.0.0",
    "@types/debug": "^4.1.13",
    "@types/http-errors": "^2.0.5",
    "@types/k6": "^1.7.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-resource-inliner": "^4.2.5",
    "@vitest/coverage-v8": "^5.0.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "vitest": "^5.0.1"
  }
}
