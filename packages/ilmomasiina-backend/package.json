{
  "name": "@tietokilta/ilmomasiina-backend",
  "version": "3.0.0-alpha.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tietokilta/ilmomasiina.git"
  },
  "scripts": {
    "start": "bnr start:dev",
    "start:dev": "bnr start:dev",
    "start:prod": "pnpm build && bnr start:prod",
    "start:bench": "pnpm build && bnr start:bench",
    "loadTest": "k6 run loadTest.js",
    "stop:prod": "pm2 stop 0",
    "monit:prod": "pm2 monit",
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist coverage",
    "typecheck": "tsc --build tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "filldb": "tsx test/fillDatabase.ts"
  },
  "betterScripts": {
    "start:dev": {
      "command": "tsx watch src/bin/server.ts",
      "env": {
        "NODE_ENV": "development",
        "DEBUG": "app:*",
        "PORT": "3001"
      }
    },
    "start:prod": {
      "command": "pm2 start dist/bin/server.js",
      "env": {
        "NODE_ENV": "production",
        "DEBUG": "app:*"
      }
    },
    "start:bench": {
      "command": "node dist/bin/server.js",
      "env": {
        "NODE_ENV": "bench",
        "DEBUG": "app:*"
      }
    }
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^9.0.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@tietokilta/ilmomasiina-models": "workspace:*",
    "@types/pg": "^8.16.0",
    "@types/validator": "^13.15.10",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "base32-encode": "^2.0.0",
    "bcrypt": "^6.0.0",
    "better-npm-run": "^0.1.1",
    "debug": "^4.4.3",
    "dotenv-flow": "^4.1.0",
    "fast-jwt": "^6.1.0",
    "fastify": "^5.7.1",
    "http-errors": "^2.0.1",
    "i18next": "^25.8.0",
    "ics": "^3.8.1",
    "lodash": "^4.17.21",
    "mailgun.js": "^12.7.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "mysql2": "^3.16.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.12",
    "pg": "^8.17.2",
    "pg-hstore": "^2.3.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.3",
    "sequelize": "^6.37.7",
    "stripe": "^20.2.0",
    "typebox": "^1.0.79",
    "umzug": "^3.8.2",
    "validator": "^13.15.26",
    "web-resource-inliner": "^8.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/debug": "^4.1.12",
    "@types/http-errors": "^2.0.5",
    "@types/k6": "^1.5.0",
    "@types/lodash": "^4.17.23",
    "@types/node": "^24.10.9",
    "@types/nodemailer": "^7.0.5",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/web-resource-inliner": "^4.2.5",
    "@vitest/coverage-v8": "^4.0.17",
    "rimraf": "^6.1.2",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.0.17"
  }
}
